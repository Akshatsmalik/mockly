# Required model credentials
GEMINI_API_KE2=
GROQ_API_KEY=
GROQ_API_KEY2=

# Comma-separated browser origins. Use HTTPS origins only in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./.data/mockly.db

# Required to enable code execution. This must point to a separately isolated judge.
# The service must accept POST /execute and enforce network, CPU, memory, and process limits.
CODE_EXECUTION_URL=
